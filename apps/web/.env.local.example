# ---------------------------------------------------------------------------
# Semua variabel OPSIONAL. Tanpa satu pun, aplikasi tetap jalan dalam "mode
# demo": peta, titik api (NASA FIRMS), gempa (BMKG), cuaca, NDVI, dan analisis
# tutupan lahan (Esri) memakai sumber data publik tanpa kredensial. Login &
# penyimpanan data pribadi (lahan, skenario) baru aktif setelah Firebase diisi.
# ---------------------------------------------------------------------------

# Firebase Client SDK — dipakai di browser HANYA untuk Firebase Auth (login).
# Firebase Console -> Project settings -> General -> Your apps -> Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — dipakai API routes (server/firebaseAdmin.ts) untuk
# Firestore & verifikasi token login. Firebase Console -> Project settings ->
# Service accounts -> Generate new private key. Tidak perlu diisi kalau
# deploy di Firebase App Hosting (memakai Application Default Credentials).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# URL services/geo (FastAPI + Google Earth Engine, dataset ESA WorldCover).
# Kosong -> analisis tutupan lahan memakai Esri/Impact Observatory 10m Land Cover.
GEO_SERVICE_URL=
# Kalau services/geo memakai GEO_API_KEY, isi nilai yang sama di sini (dikirim sebagai header X-API-Key).
GEO_SERVICE_API_KEY=

# Satelit sumber titik api NASA FIRMS: snpp (default) | noaa20 | noaa21
FIRMS_SATELLITE=

# API key Anthropic untuk asisten LandAI. Kosong -> LandAI menjawab dengan
# mode berbasis aturan (tetap memakai data asli FIRMS/BMKG/Open-Meteo).
# Dengan Firebase aktif, mode ini hanya untuk pengguna yang sudah login.
ANTHROPIC_API_KEY=
# Model Claude untuk LandAI (default claude-opus-5-5). Contoh hemat biaya: claude-sonnet-5-5, claude-haiku-4-5.
ANTHROPIC_MODEL=

# --- Penyetelan lanjutan (jarang perlu diubah) ---
# Batas waktu percobaan koneksi Node ke tiap alamat (ms). Server yang jauh dari AS
# (termasuk Indonesia) butuh > 250 ms bawaan Node supaya fetch ke NASA tidak gagal.
NET_ATTEMPT_TIMEOUT_MS=5000
# Set 1 untuk mematikan pemanasan cache saat server start (mis. di lingkungan test).
DISABLE_CACHE_WARMUP=
