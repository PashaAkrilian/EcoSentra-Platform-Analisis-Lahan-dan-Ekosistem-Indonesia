# URL aplikasi EcoSentra (apps/web) — SUMBER DATA UTAMA semua tool.
# Contoh lokal: http://localhost:8080  — contoh deploy: https://ecosentra.example.com
# Kosong -> hanya get_land_cover yang berjalan (mode MOCK, ditandai jelas);
# tool lain mengembalikan pesan bahwa konfigurasi dibutuhkan (tanpa data palsu).
ECOSENTRA_API_URL=

# (Jalur lama, opsional) URL services/geo langsung. Hanya dipakai kalau
# ECOSENTRA_API_URL kosong. Contoh: http://localhost:8001
LANDCOVER_API_URL=

# (Opsional) kalau services/geo memakai GEO_API_KEY, isi nilai yang sama di sini.
GEO_API_KEY=
