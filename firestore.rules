rules_version = '2';

// EcoSentra TIDAK mengakses Firestore langsung dari browser. Semua baca/tulis
// lewat API routes Next.js (apps/web/app/api/*) memakai Firebase Admin SDK,
// yang memverifikasi ID token login dan memeriksa kepemilikan dokumen
// (apps/web/server/firestore.ts). Admin SDK tidak terikat aturan ini.
//
// Karena itu semua akses klien langsung ditolak: kalau API key web
// (NEXT_PUBLIC_FIREBASE_API_KEY, memang publik) dipakai orang lain untuk
// memanggil Firestore SDK secara langsung, tidak ada data yang bisa dibaca
// atau diubah.
//
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
